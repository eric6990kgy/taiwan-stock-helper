DATABASE_URL=sqlite:///./investment_os.db

# Phase 5B (optional): FinMind API token. Free registration raises the rate
# limit from 300/hr to 600/hr -- see README's "Market Data" section for the
# data-use constraint (personal/non-commercial only). Leave blank to use
# FinMind's unauthenticated free tier.
FINMIND_API_TOKEN=

# Phase 7 Part 2 (optional): LINE Messaging API channel access token for
# signal alerts (LINE Notify shut down 2025-03-31, this replaces it). Leave
# blank to disable alerts entirely -- see README's "LINE Alerts" section for
# one-time setup (LINE Developers Console -> Messaging API channel).
LINE_CHANNEL_ACCESS_TOKEN=

# Phase 12 (optional): Gemini API key for the multi-agent research team
# (fundamental/technical analyst + portfolio-manager narrative opinions,
# scored the same way as the deterministic engine). Leave blank to disable
# entirely -- get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
